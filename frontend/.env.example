# Frontend (Vite) — point the siege at the Coordinator.
# Copy to .env for a hosted build, or pass ?ws= / ?api= as URL overrides at runtime.

# Local default (works with `npm run dev` or the real backend on :8080):
VITE_WS_URL=ws://localhost:8080/ws
VITE_API_BASE=http://localhost:8080

# Hosted example (TLS → use wss:// for the socket):
# VITE_WS_URL=wss://ghost-coordinator.example.com/ws
# VITE_API_BASE=https://ghost-coordinator.example.com
