# GHOST shared .env — Shresth owns this file (master.md §7).
# Copy to .env at the repo root (or backend/.env) and fill in the blanks.

# ── mode ──────────────────────────────────────────────────────────────────
MOCK=true                      # true = scripted/demo-safe · false = real LLM + live attacks

# ── coordinator ───────────────────────────────────────────────────────────
COORDINATOR_PORT=8080
PUBLIC_URL=                    # ngrok/tunnel URL so Guild can reach /events (real mode)
# RUN_ID=run_20261009_01       # optional; auto-generated if unset

# ── frontend (Vite) ───────────────────────────────────────────────────────
VITE_WS_URL=ws://localhost:8080/ws
VITE_API_BASE=http://localhost:8080

# ── clickhouse (cloud or local) ───────────────────────────────────────────
CLICKHOUSE_URL=                # e.g. http://localhost:8123 (unset = in-memory stats, mock-safe)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=ghost

# ── postgres (small mutable state; optional) ──────────────────────────────
POSTGRES_URL=                  # unset = postgres writes become no-ops

# ── guild ─────────────────────────────────────────────────────────────────
GUILD_API_KEY=
GUILD_BASE_URL=https://api.guild.ai/v1
GUILD_WORKSPACE=

# ── llm (real mode + librechat; credits proxied through Guild) ────────────
ANTHROPIC_API_KEY=

# ── semgrep (claude code plugin; browser login) ───────────────────────────

# ── cli (ghost launcher) ──────────────────────────────────────────────────
COORDINATOR_URL=http://localhost:8080
DASHBOARD_URL=http://localhost:5173
