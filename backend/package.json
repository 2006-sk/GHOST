{
  "name": "ghost-coordinator",
  "version": "1.0.0",
  "description": "GHOST Coordinator — ingests red-team agent events, owns seq + tower_health + detection verdict, writes ClickHouse, broadcasts WS to the siege frontend.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "bash scripts/seed-run.sh",
    "real-attack": "node scripts/real-attack.mjs",
    "semgrep-agent": "node scripts/semgrep-agent.mjs",
    "demo": "DEMO_DURATION_MS=30000 MAX_PER_AGENT=2 node scripts/real-attack.mjs",
    "guild-live": "bash scripts/guild-live.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  }
}
